+// ---- patch 0004: the latent taps.  See `enable_taps`/`read_taps` in verify.hpp for what they are for.
+
+void Verifier::enable_taps() {
+    if (taps_on_) return;
+    if (g_ == nullptr || le_ < 0) return;   // not initialised yet: there is nothing to stage into
+    const size_t dim = (size_t) g_->hc * (size_t) g_->n_embd;
+    const size_t want = ((size_t) g_->n_layers + 1) * (size_t) strata::kernels::kVerifyMaxT * dim;
+    if (tap_dev_ == nullptr) {
+        const OnDevice on(device_);
+        if (cudaMalloc((void**) &tap_dev_, want * sizeof(float)) != cudaSuccess) {
+            cudaGetLastError();
+            tap_dev_ = nullptr;
+            std::fprintf(stderr, "strata verify: the latent taps could not take %.1f MiB of VRAM\n",
+                         (double) want * sizeof(float) / 1048576.0);
+            return;
+        }
+        std::fprintf(stderr, "strata verify: the latent taps are on (%lld layers + the final one of every window,"
+                             " %.1f MiB)\n", (long long) g_->n_layers, (double) want * sizeof(float) / 1048576.0);
+    }
+    // A graph captured before this call holds no tap nodes, so a request that asks for taps after the first
+    // request of the same window size would read a stale buffer.  Drop every cached graph (this body runs once):
+    // the next window of that size captures it again, with the tap nodes.  The previous commit is awaited first.
+    if (cs_ != nullptr) {
+        cudaStreamSynchronize(cs_);
+        for (auto& e : exec_) { if (e != nullptr) { cudaGraphExecDestroy(e); e = nullptr; } }
+        for (auto& e : exec_nr_) { if (e != nullptr) { cudaGraphExecDestroy(e); e = nullptr; } }
+        for (auto& kv : exec_bm_) if (kv.second != nullptr) cudaGraphExecDestroy(kv.second);
+        exec_bm_.clear();
+    }
+    taps_on_ = true;
+    if (next_ != nullptr) next_->enable_taps();
+}
+
+bool Verifier::read_taps(const std::vector<int32_t>& layers, int64_t row0, int64_t n, int64_t out_row0,
+                         int64_t dst_rows, std::vector<float>& dst) {
+    if (g_ == nullptr || n <= 0 || dst_rows <= 0 || out_row0 < 0 || out_row0 > dst_rows ||
+        n > dst_rows - out_row0) return false;
+    for (const int32_t l : layers)
+        if (l < -1 || l >= g_->n_layers) return false;
+    if (tap_dev_ == nullptr) return false;
+    if (n > 0 && tap_dev_ != nullptr && g_ != nullptr) {
+        const OnDevice on(device_);
+        const size_t dim = (size_t) g_->hc * (size_t) g_->n_embd;
+        const size_t maxrows = (size_t) strata::kernels::kVerifyMaxT;
+        for (size_t k = 0; k < layers.size(); ++k) {
+            const int32_t l = layers[k];
+            if (l < 0 ? next_ != nullptr : (l < lb_ || l >= le_)) continue;   // another stage ran it
+            if (row0 < 0 || n < 0 || (size_t) (row0 + n) > maxrows) {
+                std::fprintf(stderr, "strata verify: tap rows [%lld, %lld) are outside the window\n",
+                             (long long) row0, (long long) (row0 + n));
+                return false;
+            }
+            const size_t slot = (l < 0) ? (size_t) (g_->n_layers - 1) : (size_t) l;
+            // patch 0007: `dst` is the CALLER's buffer and `dst_rows` is a stride the CALLER chose, and nothing here
+            // checked that the two agree.  A caller that sized its block for one span length and asked for a read of
+            // another wrote host heap out of bounds - which is a silent corruption at best and a crash in whoever
+            // owned those pages at worst.  The row bound above already keeps the device block honest; this one keeps
+            // the destination honest.
+            if (dst_rows <= 0 || out_row0 < 0 ||
+                dst.size() < ((size_t) k * (size_t) dst_rows + (size_t) out_row0 + (size_t) n) * dim) {
+                std::fprintf(stderr, "strata verify: tap %zu, %lld row(s) at %lld with stride %lld does not fit its "
+                                     "%zu-float destination\n", k, (long long) n, (long long) out_row0,
+                             (long long) dst_rows, dst.size());
+                return false;
+            }
+            float* d = dst.data() + ((size_t) k * (size_t) dst_rows + (size_t) out_row0) * dim;
+            if (cudaMemcpy(d, tap_dev_ + slot * maxrows * dim + (size_t) row0 * dim,
+                           (size_t) n * dim * sizeof(float), cudaMemcpyDeviceToHost) != cudaSuccess) {
+                cudaGetLastError();
+                return false;
+            }
+        }
+    }
+    return next_ == nullptr || next_->read_taps(layers, row0, n, out_row0, dst_rows, dst);
+}
 
