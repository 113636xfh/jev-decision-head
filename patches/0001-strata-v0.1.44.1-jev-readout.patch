+    patch 0007: the engine splits its GEN header on spaces AND reads one command per LINE, so a value holding a
+    newline is a second command (`lat=x\\nGEN 1 ...` reaches the same stdin) and a tab quietly fails the key's own
+    comparison, dropping the request into the shared conversation cache.  `lat` names a file the ENGINE opens with
+    fopen(,"wb"), so it is confined to the temp directory the read-out handler made."""
+    if not isinstance(value, str) or not value or any(c.isspace() or ord(c) < 32 for c in value):
+        raise ValueError(f"{name} must be one token without whitespace")
+    if path_of:
+        base = os.path.realpath(tempfile.gettempdir())
+        if not os.path.realpath(value).startswith(base + os.sep):
+            raise ValueError(f"{name} must be inside the temp directory {base}")
